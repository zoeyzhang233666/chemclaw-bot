{
  "name": "chemclaw-bot",
  "version": "0.4.0",
  "description": "ChemClaw: a chemical-industry Bot team for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "chemclaw",
    "chemical",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/zoeyzhang233666/chemclaw-bot#readme",
  "bugs": {
    "url": "https://github.com/zoeyzhang233666/chemclaw-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoeyzhang233666/chemclaw-bot.git",
    "directory": "chemclaw-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "plugin.js",
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "link.js",
    "office.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "skills/",
    "runtime/",
    "!runtime/.build-tools/**",
    "scripts/build-runtime.mjs",
    "README.zh.md",
    "NOTICE",
    "seed/catalog.json",
    "seed/domain-skills.json",
    "seed/skill-display.json",
    "seed/legacy-skill-identities.json",
    "seed/supplemental-skills.json",
    "seed/supplemental-sources.json",
    "seed/third-party-sources.json",
    "!skills/community/delivery/**",
    "!skills/domain/**/例子/**",
    "!skills/index/**",
    "capabilities/",
    "seed/"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-link.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test --test-timeout=120000 --test-force-exit \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh",
    "runtime:bundle": "node scripts/build-runtime.mjs",
    "pack:dist": "npm run runtime:bundle && npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4"
  },
  "dependencies": {
    "@changfenhuang/dsh-genui": "0.15.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.5.1",
    "dsh-free-search": "0.9.12",
    "echarts": "6.0.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "lightweight-charts": "5.0.9",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1",
    "pptxgenjs": "4.0.1",
    "yaml": "2.8.1",
    "@modelcontextprotocol/client": "2.4.0",
    "deep-view": "0.1.2",
    "imapflow": "2.9.1",
    "jpeg-js": "0.4.4",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "pngjs": "7.0.0",
    "semver": "^7.8.6",
    "undici": "8.11.2",
    "ws": "8.18.3"
  },
  "bin": {
    "ds-bot": "./bin/ds-bot-doctor.mjs"
  }
}
