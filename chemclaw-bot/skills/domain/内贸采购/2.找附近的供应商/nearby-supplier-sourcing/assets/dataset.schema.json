{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "nearby-supplier-sourcing dataset v1.0",
 "type": "object",
 "required": ["schema_version", "meta", "hazmat", "match", "logistics", "playbook", "items", "disclaimer"],
 "properties": {
  "schema_version": {"const": "1.0"},
  "meta": {
   "type": "object",
   "required": ["title", "product", "origin", "generated"],
   "properties": {
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "file_prefix": {"type": "string"},
    "generated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "prepared_by": {"type": "string"},
    "map_note": {"type": "string"},
    "playbook_note": {"type": "string"},
    "gap_note": {"type": "string"},
    "product": {
     "type": "object",
     "required": ["name", "short", "grade", "qty"],
     "properties": {
      "name": {"type": "string"},
      "short": {"type": "string"},
      "cas": {"type": "string"},
      "grade": {"type": "string"},
      "pack": {"type": "string"},
      "qty": {"type": "string"},
      "qty_tons": {"type": "number"},
      "mode": {"type": "string"},
      "self_pickup": {"type": "string"},
      "max_km": {"type": "number"}
     }
    },
    "origin": {
     "type": "object",
     "required": ["label", "short", "lat", "lon"],
     "properties": {
      "label": {"type": "string"},
      "short": {"type": "string"},
      "lat": {"type": "number", "minimum": -90, "maximum": 90},
      "lon": {"type": "number", "minimum": -180, "maximum": 180},
      "note": {"type": "string"},
      "is_example": {"type": "boolean"}
     }
    }
   }
  },
  "hazmat": {
   "type": "object",
   "required": ["is_hazardous", "verdict"],
   "properties": {
    "is_hazardous": {"type": "boolean"},
    "verdict": {"type": "string"},
    "regulatory": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "transport": {"type": "array", "items": {"type": "string"}},
    "if_spec_changes": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}}
   }
  },
  "match": {
   "type": "object",
   "required": ["dims", "tiers"],
   "properties": {
    "dims": {
     "type": "array", "minItems": 1,
     "items": {
      "type": "object",
      "required": ["name", "max", "desc"],
      "properties": {"name": {"type": "string"}, "max": {"type": "number"}, "desc": {"type": "string"}}
     }
    },
    "tiers": {
     "type": "array", "minItems": 2,
     "items": {
      "type": "object",
      "required": ["min", "code", "label"],
      "properties": {"min": {"type": "number"}, "code": {"enum": ["A", "B", "C", "D"]}, "label": {"type": "string"}}
     }
    }
   }
  },
  "logistics": {
   "type": "object",
   "required": ["anchors", "rings"],
   "properties": {
    "anchors": {
     "type": "array", "minItems": 2,
     "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
    },
    "rings": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "bands": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["max", "label"],
      "properties": {"max": {"type": "number"}, "label": {"type": "string"}}
     }
    },
    "fallback_factor": {"type": "number", "minimum": 1.0, "maximum": 1.6}
   }
  },
  "playbook": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "required": ["step", "text"],
    "properties": {"step": {"type": "string"}, "text": {"type": "string"}}
   }
  },
  "items": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "name", "short", "role", "typeCode", "region", "address",
                 "lat", "lon", "coord_note", "match", "evidence", "gaps", "ask"],
    "properties": {
     "id": {"type": "string"},
     "name": {"type": "string"},
     "short": {"type": "string"},
     "role": {"type": "string"},
     "typeCode": {"enum": ["factory", "warehouse", "registered", "trader"]},
     "region": {"type": "string"},
     "address": {"type": "string"},
     "lat": {"type": "number", "minimum": -90, "maximum": 90},
     "lon": {"type": "number", "minimum": -180, "maximum": 180},
     "coord_note": {"type": "string"},
     "process": {"type": "string"},
     "capacity": {"type": "string"},
     "brand": {"type": "string"},
     "mode": {"type": "string"},
     "action": {"type": "string"},
     "contact": {"type": "string"},
     "match_note": {"type": "string"},
     "match": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 35}},
     "evidence": {
      "type": "array", "minItems": 1,
      "items": {
       "type": "object",
       "required": ["claim", "kind", "source", "url", "date", "level", "supports"],
       "properties": {
        "claim": {"type": "string"},
        "kind": {"type": "string"},
        "source": {"type": "string"},
        "url": {"type": "string"},
        "date": {"type": "string"},
        "level": {"enum": ["A", "B", "C", "D"]},
        "supports": {"type": "string"}
       }
      }
     },
     "gaps": {"type": "array", "items": {"type": "string"}},
     "ask": {"type": "string"},
     "road_km": {"type": "number"},
     "straight_km": {"type": "number"},
     "ratio": {"type": "number"},
     "hours": {"type": "number"},
     "distance_source": {"enum": ["osrm", "estimated"]},
     "geometry": {"type": "array"},
     "matchTotal": {"type": "number"},
     "tier": {"enum": ["A", "B", "C", "D"]},
     "tierLabel": {"type": "string"},
     "lScore": {"type": "number"},
     "band": {"type": "string"},
     "rank": {"type": "number"}
    }
   }
  },
  "disclaimer": {"type": "array", "minItems": 1, "items": {"type": "string"}}
 }
}
