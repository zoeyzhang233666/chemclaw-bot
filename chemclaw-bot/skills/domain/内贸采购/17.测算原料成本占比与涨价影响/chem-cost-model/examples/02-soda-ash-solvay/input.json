 "formula_doc": [
  {
   "name": "单项成本",
   "f": "c_i = q_i × p_i",
   "v": "单耗(t/t) × 价格(元/t) = 元/吨产品"
  },
  {
   "name": "理论原料成本",
   "f": "C = Σ c_i",
   "v": "只含已计价原料，缺价原料不按 0 计"
  },
  {
   "name": "成本占比",
   "f": "w_i = c_i / C",
   "v": "缺价原料存在时为\"占已计价部分\"口径"
  },
  {
   "name": "涨价影响",
   "f": "Δc_i = q_i × p_i × r",
   "v": "r 为涨跌幅，+10% 即 0.10"
  }
 ]
}