 "formula_doc": [
  {
   "name": "化学计量（理论单耗）",
   "f": "q_theo = ν_原料 × MW_原料 ÷ (ν_产品 × MW_产品)",
   "v": "PA 1×148.117÷390.564 = 0.3792 t/t；2-EH 2×130.231÷390.564 = 0.6669 t/t"
  },
  {
   "name": "单位产品理论原料成本",
   "f": "C = Σ_i (q_i × p_i)",
   "v": "C = 0.383×苯酐价 + 0.678×异辛醇价"
  },
  {
   "name": "单项成本占比",
   "f": "w_i = q_i × p_i ÷ C × 100%",
   "v": "—"
  },
  {
   "name": "单项价格变动影响",
   "f": "Δc_i = q_i × Δp_i = q_i × p_i × r_i",
   "v": "r_i 为涨跌幅（±5%/±10%）"
  },
  {
   "name": "组合情景",
   "f": "C' = Σ_i q_i × p_i × (1 + r_i) ；ΔC = C' − C",
   "v": "—"
  },
  {
   "name": "历史理论原料成本",
   "f": "C_t = Σ_i q_i(t) × p_i(t)",
   "v": "q 固定、p 取真实序列"
  },
  {
   "name": "历史贡献分解",
   "f": "ΔC_T = Σ_i (q_i × (p_i,T − p_i,0))；贡献比 = Δc_i ÷ ΔC_T",
   "v": "若 ΔC_T ≈ 0 则不给贡献比"
  }
 ],
