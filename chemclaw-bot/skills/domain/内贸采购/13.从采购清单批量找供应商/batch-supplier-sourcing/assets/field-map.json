{
  "_meta": {
    "version": "1.0.0",
    "purpose": "采购清单字段映射：把任意格式清单的表头/列位置映射到标准字段。builder 会先做 UTF-8 清洗 + 别名匹配，匹配失败的列写入 parse_notes 供人工确认。"
  },
  "matching": {
    "normalize": ["去空格/全角转半角/去除括号内注释", "小写", "去除末尾单位（吨/千克/公斤/桶/袋）"],
    "strategy": "先精确匹配 aliases，再做包含匹配（按 alias 长度降序），最后按正则 hint 匹配。一列只归属一个字段；名称列优先级最高。"
  },
  "fields": [
    {
      "key": "row_no",
      "label": "行号",
      "required": false,
      "aliases": ["序号", "行号", "项号", "编号", "no", "no.", "#", "item", "item no", "line", "行次"],
      "hints": ["^序\\s*号$"]
    },
    {
      "key": "code",
      "label": "物料编号（ERP/公司内部编码）",
      "required": false,
      "aliases": ["物料编码", "物料号", "物料代码", "编码", "代码", "存货编码", "part no", "item code", "sku"],
      "hints": ["编码$", "代码$"],
      "note": "编号不是标准字段，只用于回填原始行，不参与标准化匹配。"
    },
    {
      "key": "raw_name",
      "label": "物料名称（原始写法）",
      "required": true,
      "aliases": ["物料名称", "品名", "名称", "物料", "物品名称", "产品名称", "商品名称", "原料名称", "材料名称", "化学品名称", "货物名称", "material", "product", "name", "item name", "description"],
      "hints": ["(名称|品名)$"],
      "note": "识别化学品名称、别名、CAS 的主入口。缺失时尝试用 combination 字段。"
    },
    {
      "key": "combination",
      "label": "名称+CAS 合并列",
      "required": false,
      "aliases": ["物料名称及cas", "名称及cas", "品名(cas)", "名称(cas)", "品名cas", "cas号或名称", "化学名/cas"],
      "hints": ["cas.*名称|名称.*cas"]
    },
    {
      "key": "cas",
      "label": "CAS 登记号",
      "required": false,
      "aliases": ["cas", "cas号", "cas no", "cas no.", "cas登记号", "cas编号", "cas#", "casrn", "登记号"],
      "hints": ["cas"],
      "note": "格式校验：^\\d{2,7}-\\d{2}-\\d$；校验位失败 → ambiguity P0（CAS 疑似错误）。"
    },
    {
      "key": "form",
      "label": "形态/等级/牌号",
      "required": false,
      "aliases": ["规格形态", "形态", "产品形态", "等级", "牌号", "grade", "form", "类型", "品级"],
      "hints": ["(形态|等级|牌号)$"]
    },
    {
      "key": "spec",
      "label": "规格/技术要求",
      "required": false,
      "aliases": ["规格", "规格型号", "技术要求", "技术规格", "执行标准", "质量要求", "指标要求", "规格要求", "标准", "spec", "specification", "grade", "参数", "备注要求"],
      "hints": ["(规格|要求|标准)"],
      "note": "若与本字段命中的列被识别为纯度列，则纯度单独抽出，剩余文本保留在 spec。"
    },
    {
      "key": "purity",
      "label": "纯度/含量/浓度",
      "required": false,
      "aliases": ["纯度", "含量", "浓度", "主含量", "有效含量", "purity", "content", "assay", "%含量"],
      "hints": ["(纯度|含量|浓度)"],
      "note": "标准化为数值 %；'27.5%双氧水' 这类名称内浓度应抽到 form，不应写入 purity。"
    },
    {
      "key": "quantity",
      "label": "数量",
      "required": true,
      "aliases": ["数量", "需求量", "采购量", "需用量", "用量", "订单量", "数量(吨)", "qty", "quantity", "amount"],
      "hints": ["(数量|用量|需求量)$"]
    },
    {
      "key": "unit",
      "label": "计量单位",
      "required": true,
      "aliases": ["单位", "计量单位", "单位名称", "uom", "unit", "units"],
      "hints": ["^单位"]
    },
    {
      "key": "packing",
      "label": "包装方式",
      "required": false,
      "aliases": ["包装", "包装方式", "包装规格", "包装形式", "packing", "pack"],
      "hints": ["^包装"]
    },
    {
      "key": "annual_usage",
      "label": "年用量",
      "required": false,
      "aliases": ["年用量", "年需求量", "年度用量", "年耗量", "年需求", "annual", "annual usage"],
      "hints": ["年.*(用量|需求)"]
    },
    {
      "key": "monthly_usage",
      "label": "月用量",
      "required": false,
      "aliases": ["月用量", "月需求量", "月耗量", " monthly"],
      "hints": ["月.*(用量|需求)"]
    },
    {
      "key": "delivery",
      "label": "交付地点/到货地",
      "required": false,
      "aliases": ["交付地点", "交货地点", "到货地", "收货地", "使用地点", "送货地址", "交付地", "收货地址", "delivery", "ship to"],
      "hints": ["(交付|交货|收货|到货)"]
    },
    {
      "key": "application",
      "label": "用途/下游工序",
      "required": false,
      "aliases": ["用途", "使用工序", "下游应用", "应用", "工序", "application", "use"],
      "hints": ["(用途|工序|应用)"]
    },
    {
      "key": "supplier",
      "label": "现有供应商/在用货源",
      "required": false,
      "aliases": ["现有供应商", "供货商", "供应商", "在用供应商", "原供应商", "supplier", "vendor"],
      "hints": ["供应商"]
    },
    {
      "key": "price",
      "label": "参考价/预算单价",
      "required": false,
      "aliases": ["参考价", "单价", "预算价", "含税单价", "价格", "price", "unit price"],
      "hints": ["(单价|价格|参考价)"]
    },
    {
      "key": "hazard",
      "label": "危险属性（清单自带声明）",
      "required": false,
      "aliases": ["危险属性", "是否危化品", "危化品", "危险品", "hazard", "hazardous"],
      "hints": ["(危险|危化)"],
      "note": "清单自带的危险属性只作为对账输入，最终以字典 + 危化品目录核对结果为准。"
    },
    {
      "key": "notes",
      "label": "备注",
      "required": false,
      "aliases": ["备注", "说明", "其他要求", "其他技术要求", "备注说明", "remark", "remarks", "note", "notes", "comment"],
      "hints": ["^备注"]
    }
  ],
  "required_policy": {
    "minimum": ["raw_name|combination", "quantity", "unit"],
    "on_missing": "缺少最低字段的行进入 ambiguities（A-MISSING-FIELD），status=blocked；不得推测补全。",
    "optional_ok": "规格、纯度、包装、用途缺失不阻塞，但在标准化表中标注“规格待补充”，供询价澄清。"
  },
  "header_policy": {
    "skip_rows_contains": ["合计", "总计", "小计", "审核", "批准", "制表", "填表人", "签字"],
    "multirow_header": "若首行是标题（合并单元格），读取下一非空行作为表头；表头行数可用 project.parse.header_row 指定（1 起）。",
    "sheet_policy": "默认读取第一个工作表；也可用 project.parse.sheet 指定；多个工作表时自动跳过空表。"
  }
}
