{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chem/import-window/data.schema.json",
  "title": "进口窗口判断 · 案例数据契约",
  "description": "一份 case.json 描述：某商品在某海外市场到某中国区域的进口报价、国内现货、汇率、运费、税费、历史序列、来源与缺口。所有品种相关的具体值（税率、运费、规格）都必须来自本文件，不得写进 Skill 逻辑。",
  "type": "object",
  "required": [
    "schema_version", "meta", "product", "quote", "domestic", "fx", "tax", "params", "sources"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },

    "meta": {
      "type": "object",
      "required": ["case_id", "title", "generated_at", "disclaimer"],
      "properties": {
        "case_id": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 4 },
        "subtitle": { "type": "string" },
        "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "currency_quote": { "type": "string" },
        "currency_local": { "type": "string" },
        "unit": { "type": "string" },
        "analyst": { "type": "string" },
        "disclaimer": { "type": "string", "minLength": 10 },
        "engine_version": { "type": "string" }
      }
    },

    "asof": {
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "today": { "type": "string" },
        "label": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "product": {
      "type": "object",
      "required": ["name_cn", "spec", "hs_code_cn"],
      "properties": {
        "name_cn": { "type": "string", "minLength": 2 },
        "alias": { "type": "string" },
        "name_en": { "type": "string" },
        "cas": { "type": "string" },
        "hs_code_cn": { "type": "string", "pattern": "^[0-9]{6,10}$" },
        "spec": { "type": "string", "minLength": 2 },
        "spec_note": { "type": "string" },
        "unit_note": { "type": "string" }
      }
    },

    "request": {
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "origin_detail": { "type": "string" },
        "destination": { "type": "string" },
        "volume_ton": { "type": ["number", "null"] },
        "incoterm": { "type": "string" },
        "delivery_compare": { "type": "string" },
        "transit_days": { "type": ["number", "null"] }
      }
    },

    "quote": {
      "type": "object",
      "required": ["date", "price_usd", "term", "spec", "source_id"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "price_usd": { "type": "number", "exclusiveMinimum": 0 },
        "price_low_usd": { "type": ["number", "null"] },
        "price_high_usd": { "type": ["number", "null"] },
        "premium_usd": { "type": ["number", "null"] },
        "term": { "enum": ["FOB", "CFR", "CIF", "EXW", "DDP"] },
        "port": { "type": "string" },
        "spec": { "type": "string" },
        "quantity": { "type": "string" },
        "freight_usd": { "type": ["number", "null"] },
        "source_id": { "type": "string", "minLength": 3 },
        "source_secondary_ids": { "type": "array", "items": { "type": "string" } },
        "source_note": { "type": "string" },
        "quote_type": { "type": "string" },
        "buyer_reality": { "type": "string" }
      }
    },

    "domestic": {
      "type": "object",
      "required": ["date", "price_cny", "tax_included", "delivery", "spec", "source_id"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "price_cny": { "type": "number", "exclusiveMinimum": 0 },
        "price_low_cny": { "type": ["number", "null"] },
        "price_high_cny": { "type": ["number", "null"] },
        "region": { "type": "string" },
        "market": { "type": "string" },
        "delivery": { "type": "string", "minLength": 2 },
        "tax_included": { "type": "boolean" },
        "spec": { "type": "string" },
        "quantity": { "type": "string" },
        "source_id": { "type": "string", "minLength": 3 },
        "source_note": { "type": "string" }
      }
    },

    "fx": {
      "type": "object",
      "required": ["date", "rate", "source_id", "rows"],
      "properties": {
        "id": { "type": "string" },
        "pair": { "type": "string" },
        "quote": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "rate": { "type": "number", "exclusiveMinimum": 0 },
        "source_id": { "type": "string" },
        "series_note": { "type": "string" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "rate"],
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "rate": { "type": "number", "exclusiveMinimum": 0 },
              "source_id": { "type": "string" }
            }
          }
        }
      }
    },

    "freight": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "enum": ["none", "quote", "series", "simulated", "manual"] },
        "usd_per_ton": { "type": ["number", "null"] },
        "date": { "type": ["string", "null"] },
        "basis": { "type": "string" },
        "quality": { "enum": ["missing", "actual", "proxy", "reference", "simulated", "index"] },
        "route": { "type": "string" },
        "why_missing": { "type": "string" },
        "series": {
          "type": "object",
          "properties": {
            "rows": { "type": "array", "items": { "type": "object" } }
          }
        },
        "reference_values": { "type": "array", "items": { "type": "object" } }
      }
    },

    "insurance": {
      "type": "object",
      "properties": {
        "rate": { "type": ["number", "null"] },
        "basis": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "tax": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "hs_code": { "type": "string" },
        "note": { "type": "string" },
        "preferential": { "type": "object" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["effective_from", "duty_rate", "vat_rate"],
            "properties": {
              "id": { "type": "string" },
              "effective_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "duty_rate": { "type": "number", "minimum": 0, "maximum": 100 },
              "duty_basis": { "type": "string" },
              "duty_hs": { "type": "string" },
              "vat_rate": { "type": "number", "minimum": 0, "maximum": 100 },
              "vat_basis": { "type": "string" },
              "provisional": { "type": "boolean" },
              "exact": { "type": "boolean" },
              "source_id": { "type": "string" },
              "source_note": { "type": "string" }
            }
          }
        }
      }
    },

    "params": {
      "type": "object",
      "properties": {
        "vat_recoverable": { "type": ["boolean", "null"] },
        "vat_rec_note": { "type": "string" },
        "inland_cost_cny": { "type": ["number", "null"] },
        "inland_note": { "type": "string" },
        "other_cost_cny": { "type": ["number", "null"] },
        "dutiable_adjust_rate": { "type": ["number", "null"] },
        "import_finance_rate": { "type": ["number", "null"] },
        "insurance_rate": { "type": ["number", "null"] }
      }
    },

    "compatibility_manual": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "detail": { "type": "string" }
        }
      }
    },

    "quotes_hist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "price_usd", "term"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "price_usd": { "type": "number" },
          "term": { "enum": ["FOB", "CFR", "CIF", "EXW", "DDP"] },
          "spec": { "type": "string" },
          "port": { "type": "string" },
          "source_id": { "type": "string" },
          "source_note": { "type": "string" }
        }
      }
    },

    "domestic_hist": {
      "type": "object",
      "properties": {
        "series_id": { "type": "string" },
        "region": { "type": "string" },
        "unit": { "type": "string" },
        "tax_included": { "type": "boolean" },
        "delivery": { "type": "string" },
        "spec": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "price_cny"],
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "price_cny": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },

    "history_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "kind", "text"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "kind": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },

    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "text": { "type": "string" },
          "source_id": { "type": ["string", "null"] }
        }
      }
    },

    "sim_scenarios": {
      "type": "array",
      "description": "模拟参数情景。必须 is_simulated=true，仅用于验证计算器交互。",
      "items": {
        "type": "object",
        "required": ["id", "label", "is_simulated"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "is_simulated": { "const": true },
          "note": { "type": "string" },
          "why": { "type": "string" },
          "overrides": { "type": "object" }
        }
      }
    },

    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "item", "impact", "fix"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low"] },
          "item": { "type": "string", "minLength": 4 },
          "impact": { "type": "string", "minLength": 6 },
          "fix": { "type": "string", "minLength": 6 },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "title", "date", "url", "tier"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "publisher": { "type": "string", "minLength": 2 },
          "title": { "type": "string", "minLength": 2 },
          "date": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" },
          "excerpt": { "type": "string" },
          "tier": { "enum": ["A", "B", "C"] },
          "tier_note": { "type": "string" }
        }
      }
    },

    "data_integrity": {
      "type": "object",
      "properties": {
        "history_anchors_offshore": { "type": "number" },
        "history_anchors_domestic": { "type": "number" },
        "history_anchors_paired": { "type": "number" },
        "one_year_series_available": { "type": "boolean" },
        "statement": { "type": "string" }
      }
    }
  }
}
