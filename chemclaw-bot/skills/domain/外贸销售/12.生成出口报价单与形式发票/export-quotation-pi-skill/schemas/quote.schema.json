{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/quote.schema.json",
  "title": "Export quotation / proforma invoice case",
  "description": "Data contract shared by the HTML editor, the Word/PDF builders and the Excel workbook. Only user-confirmed values belong in these fields; missing values stay empty and are rendered as placeholders.",
  "type": "object",
  "required": ["meta", "docType", "state", "reference", "issueDate", "seller", "buyer", "currency", "tradeTerm", "items", "amountState", "packing", "delivery", "payment", "validity", "documents", "bank", "view"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["skillVersion", "dataClass", "caseId"],
      "properties": {
        "skillVersion": {"type": "string"},
        "dataClass": {"type": "string", "description": "SIMULATED — DEMO DATA for examples, USER-CONFIRMED for real cases"},
        "dataClassNote": {"type": "string"},
        "caseId": {"type": "string"},
        "product": {"type": "string"},
        "destination": {"type": "string"},
        "preparedAt": {"type": "string"},
        "preparedBy": {"type": "string"},
        "scenario": {"type": "string"}
      }
    },
    "docType": {"type": "string", "enum": ["QUOTATION", "PROFORMA_INVOICE"]},
    "state": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": {"type": "string", "enum": ["DRAFT", "READY_FOR_REVIEW", "FORMAL"]},
        "reviewConfirmed": {"type": "boolean"},
        "confirmedBy": {"type": "string"},
        "confirmedAt": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "required": ["quoteNo"],
      "properties": {
        "text": {"type": "string"},
        "quoteNo": {"type": "string"},
        "quotationRef": {"type": "string"},
        "buyerInquiryRef": {"type": "string"},
        "supplierQuoteRef": {"type": "string"},
        "exporterReference": {"type": "string"},
        "buyerPoNo": {"type": "string"}
      }
    },
    "issueDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "seller": {"$ref": "#/definitions/party"},
    "buyer": {"$ref": "#/definitions/party"},
    "currency": {
      "type": "object",
      "required": ["code", "decimals"],
      "properties": {
        "code": {"type": "string", "minLength": 3, "maxLength": 3},
        "name": {"type": "string"},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 4},
        "exchangeRate": {
          "type": "object",
          "properties": {
            "base": {"type": "string"}, "rate": {"type": ["number", "string"]},
            "asOf": {"type": "string"}, "source": {"type": "string"},
            "state": {"type": "string", "enum": ["reference", "confirmed"]},
            "display": {"type": "string", "enum": ["none", "footnote"]}
          }
        }
      }
    },
    "tradeTerm": {
      "type": "object",
      "required": ["code", "version", "namedPlace"],
      "properties": {
        "code": {"type": "string", "enum": ["EXW", "FCA", "FAS", "FOB", "CFR", "CIF", "CPT", "CIP", "DAP", "DPU", "DDP"]},
        "version": {"type": "string", "enum": ["2010", "2020"]},
        "namedPlace": {"type": "string"},
        "namedPlaceKind": {"type": "string", "enum": ["port", "airport", "place", "address", "warehouse"]},
        "transportMode": {"type": "string", "enum": ["SEA", "AIR", "RAIL", "ROAD", "MULTIMODAL"]},
        "insuranceBasis": {"type": "string"},
        "costAllocation": {
          "type": "object",
          "properties": {
            "exportPacking": {"type": "string", "enum": ["Seller", "Buyer"]},
            "loadingCharges": {"type": "string", "enum": ["Seller", "Buyer"]},
            "exportCustoms": {"type": "string", "enum": ["Seller", "Buyer"]},
            "originCharges": {"type": "string", "enum": ["Seller", "Buyer"]},
            "mainFreight": {"type": "string", "enum": ["Seller", "Buyer"]},
            "insurance": {"type": "string", "enum": ["Seller", "Buyer"]},
            "destinationCharges": {"type": "string", "enum": ["Seller", "Buyer"]},
            "importCustoms": {"type": "string", "enum": ["Seller", "Buyer"]},
            "unloading": {"type": "string", "enum": ["Seller", "Buyer"]}
          }
        }
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/item"}},
    "amountState": {"type": "string", "enum": ["confirmed", "draft", ""]},
    "amountConfirmedValue": {"type": ["number", "null"]},
    "charges": {"type": "array", "items": {"$ref": "#/definitions/charge"}},
    "packing": {
      "type": "object",
      "properties": {
        "summary": {"type": "string"}, "terms": {"type": "string"},
        "bagNetKg": {"type": ["number", "null"]}, "shippingUnits": {"type": "string"}
      }
    },
    "totalPackageCount": {"type": ["string", "number"]},
    "totalGrossWeight": {"type": "string"},
    "totalVolume": {"type": "string"},
    "freight": {
      "type": "object",
      "properties": {"estimatedPol": {"type": "string"}, "estimatedPod": {"type": "string"}, "mode": {"type": "string"}, "incotermNote": {"type": "string"}}
    },
    "delivery": {
      "type": "object",
      "properties": {
        "leadTime": {"type": "string"}, "basis": {"type": "string"},
        "readyDateMode": {"type": "string", "enum": ["relative", "fixed"]},
        "daysAfterReceipt": {"type": "number"},
        "partialShipment": {"type": "string"}, "transhipment": {"type": "string"}
      }
    },
    "payment": {
      "type": "object",
      "required": ["terms"],
      "properties": {
        "code": {"type": "string", "enum": ["PREPAY", "LC", "DP", "DP_DA", "OA", "MIXED", ""]},
        "terms": {"type": "string"},
        "amountPct": {"type": ["number", "null"]},
        "lcType": {"type": "string"},
        "lcOpenedBy": {"type": "string"},
        "bank": {"type": "string"},
        "beneficiary": {"type": "string"},
        "beneficiaryNote": {"type": "string"}
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["date", "days"]},
        "validUntil": {"type": "string"},
        "days": {"type": "number"}
      }
    },
    "documents": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "copies": {"type": "string"}}}},
    "bank": {
      "type": "object",
      "description": "Placeholder only unless display, sanitized=false and detailsConfirmed are all set consciously by the seller.",
      "properties": {
        "display": {"type": "boolean"},
        "sanitized": {"type": "boolean"},
        "detailsConfirmed": {"type": "boolean"},
        "bankName": {"type": "string"},
        "accountName": {"type": "string"},
        "accountNumber": {"type": "string"},
        "swift": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "logo": {"type": "boolean"}, "signature": {"type": "boolean"},
        "watermark": {"type": "boolean"}, "accentColor": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "name": {"type": "string"}, "signatoryTitle": {"type": "string"},
        "itemsChecked": {"type": "boolean"}, "formalApproved": {"type": "boolean"},
        "acknowledged": {"type": "array", "items": {"type": "object", "properties": {"code": {"type": "string"}, "reason": {"type": "string"}, "by": {"type": "string"}}}}
      }
    },
    "fatal": {"type": "array", "items": {"type": "object", "properties": {"code": {"type": "string"}, "where": {"type": "string"}, "msg": {"type": "string"}}}}
  },
  "definitions": {
    "party": {
      "type": "object",
      "required": ["name", "address"],
      "properties": {
        "name": {"type": "string"}, "address": {"type": "string"}, "country": {"type": "string"},
        "contact": {"type": "string"}, "position": {"type": "string"}, "phone": {"type": "string"},
        "email": {"type": "string"}, "taxId": {"type": "string"}, "npwp": {"type": "string"},
        "shortName": {"type": "string"}, "logoText": {"type": "string"}
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "unit", "quantity"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string", "description": "English trade name + chemical name"},
        "cas": {"type": "string", "pattern": "^$|^\\d{2,7}-\\d{2}-\\d$"},
        "spec": {"type": "string"},
        "hsCode": {"type": "string"},
        "origin": {"type": "string"},
        "unit": {"type": "string"},
        "quantity": {"type": ["number", "string"]},
        "unitPrice": {"type": ["number", "string", "null"], "description": "Mandatory for a formal document"},
        "discountPct": {"type": ["number", "null"]},
        "amountState": {"type": "string", "enum": ["confirmed", "draft", ""]},
        "amountConfirmedValue": {"type": ["number", "null"]},
        "packageCount": {"type": ["number", "null"]},
        "packageWeight": {
          "type": "object",
          "properties": {"value": {"type": ["number", "null"]}, "unit": {"type": "string", "enum": ["KG", "G", "MT"]}, "net": {"type": ["number", "null"]}, "basis": {"type": "string"}}
        },
        "dangerousGoods": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"type": "string", "enum": ["DG", "NOT_REGULATED", "UNKNOWN"]},
            "unNumber": {"type": "string"}, "properShippingName": {"type": "string"},
            "class": {"type": "string"}, "packingGroup": {"type": "string"},
            "unPackagingCode": {"type": "string"}, "msdsVersion": {"type": "string"},
            "basis": {"type": "string"}, "ghsSummary": {"type": "string"}
          }
        }
      }
    },
    "charge": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "amount": {"type": ["number", "string", "null"]},
        "addToTotal": {"type": "boolean"},
        "basis": {"type": "string", "enum": ["actual", "estimated"]},
        "note": {"type": "string"}
      }
    }
  }
}
