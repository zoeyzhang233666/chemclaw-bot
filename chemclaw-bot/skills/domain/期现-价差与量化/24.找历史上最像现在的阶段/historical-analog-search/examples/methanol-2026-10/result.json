{
 "config": {
  "product": {
   "key": "MA",
   "name": "甲醇",
   "exchange": "郑州商品交易所",
   "contract_prefix": "MA",
   "spec": "MA 主力合约（100ppI 基差表中的主力合约）",
   "spot_spec": "生意社甲醇基准价（国产/进口综合，元/吨，含税）",
   "unit": "元/吨",
   "note": "现货=生意社(生意社)甲醇基准价；期货=当日主力合约收盘/结算；基差=现货-期货，与生意社主力基差表口径一致。"
  },
  "indicators": [
   {
    "key": "basis_pct",
    "name": "基差率",
    "short": "基差率",
    "family": "structure",
    "unit": "%",
    "form": "level",
    "source": "100ppi 主力基差表（现货-主力）/现货",
    "std_method": "rolling_z",
    "role": "core",
    "default_weight": 1.5,
    "rationale": "现货相对期货的贴水/升水程度，是现期结构最直接的度量；无趋势漂移，适合水平值+滚动标准化。"
   },
   {
    "key": "basis_pct_pctile",
    "name": "基差率历史分位(3年滚动)",
    "short": "基差分位",
    "family": "structure",
    "unit": "%",
    "form": "level",
    "source": "由基差率在 expanding/rolling 3年窗口内计算",
    "std_method": "rank",
    "role": "optional",
    "default_weight": 0.0,
    "rationale": "把基差放到自身历史分布中看，避免绝对水平随宏观通胀漂移。"
   },
   {
    "key": "ret_4w",
    "name": "近4周价格涨跌",
    "short": "4周涨跌",
    "family": "price",
    "unit": "%",
    "form": "change",
    "source": "主力收盘价 4 周变化",
    "std_method": "rolling_z",
    "role": "core",
    "default_weight": 1.2,
    "rationale": "捕捉短期动量；用变化率而非价格水平，避免长期中枢漂移。"
   },
   {
    "key": "ret_13w",
    "name": "近13周价格涨跌",
    "short": "13周涨跌",
    "family": "price",
    "unit": "%",
    "form": "change",
    "source": "主力收盘价 13 周变化",
    "std_method": "rolling_z",
    "role": "core",
    "default_weight": 1.0,
    "rationale": "季度级别趋势位置，与基差一起刻画「价格在什么位置、结构怎么样」。"
   },
   {
    "key": "spot_rank_52w",
    "name": "现货价52周分位",
    "short": "价格分位",
    "family": "price",
    "unit": "%",
    "form": "level",
    "source": "现货价在过去52周的百分位",
    "std_method": "rank",
    "role": "optional",
    "default_weight": 0.8,
    "rationale": "价格绝对水平无量纲化后入模：同样「高位」的比较不依赖通胀与合约换月。"
   },
   {
    "key": "port_inv",
    "name": "港口样本库存",
    "short": "港口库存",
    "family": "inventory",
    "unit": "万吨",
    "form": "level",
    "source": "隆众资讯 中国甲醇港口样本库存（周度，周三调查日）",
    "std_method": "rolling_z",
    "role": "core",
    "default_weight": 1.2,
    "rationale": "有季节性与样本口径变化，用滚动均值/标准差去中心和缩放。"
   },
   {
    "key": "port_inv_rank_3y",
    "name": "港口库存3年分位",
    "short": "库存分位",
    "family": "inventory",
    "unit": "%",
    "form": "level",
    "source": "港口库存在过去156周的百分位",
    "std_method": "rank",
    "role": "optional",
    "default_weight": 0.0,
    "rationale": "库存绝对量中枢年际漂移明显（样本扩容），分位更可比。"
   },
   {
    "key": "port_inv_wow",
    "name": "港口库存周变化",
    "short": "库存环比",
    "family": "inventory",
    "unit": "万吨",
    "form": "change",
    "source": "两期港口库存之差",
    "std_method": "rolling_z",
    "role": "optional",
    "default_weight": 0.6,
    "rationale": "库存方向（累库/去库）比水平更能区分阶段。"
   },
   {
    "key": "producer_inv",
    "name": "生产企业库存",
    "short": "厂库",
    "family": "inventory",
    "unit": "万吨",
    "form": "level",
    "source": "隆众资讯 中国甲醇样本生产企业库存",
    "std_method": "rolling_z",
    "role": "optional",
    "default_weight": 0.6,
    "rationale": "内地工厂库存反映上游压力，与港口库存互补。"
   },
   {
    "key": "operating_rate",
    "name": "装置产能利用率",
    "short": "开工率",
    "family": "supply",
    "unit": "%",
    "form": "level",
    "source": "隆众资讯 中国甲醇产量及产能利用率周数据",
    "std_method": "rolling_z",
    "role": "core",
    "default_weight": 1.0,
    "rationale": "供给端的直接度量；0-100 有界，滚动标准化后再做截尾。"
   },
   {
    "key": "output_wt",
    "name": "周产量",
    "short": "产量",
    "family": "supply",
    "unit": "万吨",
    "form": "level",
    "source": "隆众资讯 中国甲醇产量周数据（吨→万吨）",
    "std_method": "rolling_z",
    "role": "optional",
    "default_weight": 0.0,
    "rationale": "与开工率高度共线，默认权重 0，仅备选。"
   },
   {
    "key": "arrivals",
    "name": "周度到港量",
    "short": "到港量",
    "family": "supply",
    "unit": "万吨",
    "form": "level",
    "source": "隆众资讯 中国甲醇样本到港量周数据",
    "std_method": "pctile_rank",
    "role": "optional",
    "default_weight": 0.8,
    "rationale": "到港量波动极大且分布右偏，用全历史分位数比 z 分数稳健。"
   },
   {
    "key": "spread_1_5",
    "name": "月差 近月-次月(%/月)",
    "short": "月差1-5",
    "family": "structure",
    "unit": "%",
    "form": "level",
    "source": "由各交割月合约日线构造：近月-次近月，按月份差归一",
    "std_method": "rolling_z",
    "role": "optional",
    "default_weight": 0.7,
    "rationale": "月差刻画近端紧张程度；日度可得，历史最长。"
   },
   {
    "key": "spread_1_3",
    "name": "月差 近月-第三月(%/月)",
    "short": "月差1-3",
    "family": "structure",
    "unit": "%",
    "form": "level",
    "source": "近月与第三个交割月的价差，按月份差归一",
    "std_method": "rolling_z",
    "role": "optional",
    "default_weight": 0.0,
    "rationale": "更远端的期限结构斜率，用于对照。"
   },
   {
    "key": "vol_20d",
    "name": "20日实现波动率",
    "short": "波动率",
    "family": "price",
    "unit": "%",
    "form": "level",
    "source": "主力连续日对数收益 20 日年化标准差",
