  "similarity_methods": [
   {
    "key": "mae",
    "name": "加权平均绝对差(MAE)",
    "formula": "sim = 1 - Σ w_i·|z_hist - z_now| / Σ w_i / c",
    "c": 3.0,
    "note": "默认方法。以「平均偏离几个标准差」计，直观且对小样本稳健。"
   },
   {
    "key": "rmse",
    "name": "加权均方根差(RMSE)",
    "formula": "sim = 1 - sqrt(Σ w_i·(z_hist-z_now)^2/Σw_i) / c",
    "note": "对单个指标的大偏离更敏感，适合只想排除「某一维完全不像」的情况。"
   },
   {
    "key": "cosine",
    "name": "加权余弦相似度",
    "formula": "sim = Σ w_i z_i^h z_i^c / sqrt(Σw z^2)·sqrt(Σw z^2)",
    "note": "只看方向和相对形态，不看水平；对全正/全负的组合不敏感。"
   },
   {
    "key": "mahalanobis",
    "name": "协方差加权距离",
    "formula": "d = sqrt((z_h-z_c)^T S^-1 (z_h-z_c))",
    "note": "考虑指标间相关性，避免重复计数；对样本量敏感，S 用收缩估计。"
   }
  ]
 },
