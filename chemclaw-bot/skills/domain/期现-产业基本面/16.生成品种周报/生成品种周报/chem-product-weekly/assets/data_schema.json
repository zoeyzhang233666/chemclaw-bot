      "type": "boolean"
     }
    }
   }
  },
  "anchors": {
   "type": "array",
   "note": "{date,name,value,unit,basis,note,src,url}"
  },
  "fund": {
   "type": "array",
   "note": "{date,metric,value,unit,chg,period,src,url,in_week}"
  },
  "upstream": {
   "type": "array",
   "note": "{date,item,value,unit,basis,chg,src,url}"
  },
  "gaps": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "lastyear": {
   "type": "object",
   "note": "{合约: {ly_contract, week_avg, week_close, this_mon_close, yoy_pct}}"
