    {"type": "regions", "caption": "{区域分布}", "src": ["S01"], "items": []},
    {"type": "table", "caption": "{产能口径冲突对照}", "columns": [{"k": "项目"}, {"k": "数值A"}, {"k": "数值B"}, {"k": "差异原因"}, {"k": "建议"}, {"k": "来源"}], "rows": []},
