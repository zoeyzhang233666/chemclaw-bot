    {"type": "table", "caption": "{贸易数据}", "columns": [{"k": "指标"}, {"k": "数值"}, {"k": "时点"}, {"k": "口径/来源"}, {"k": "来源"}], "rows": []},
    {"type": "table", "caption": "{区域市场结构}", "columns": [{"k": "区域"}, {"k": "集散地"}, {"k": "角色"}, {"k": "研究价值"}, {"k": "来源"}], "rows": []},
    {"type": "text", "title": "{期现关系的产业逻辑}", "html": "<p>{...}</p>", "src": ["S01"]}
  ]},
  {"id": "indicators", "name": "指标与逻辑", "note": "{每条指标给出为什么看}", "body": [
