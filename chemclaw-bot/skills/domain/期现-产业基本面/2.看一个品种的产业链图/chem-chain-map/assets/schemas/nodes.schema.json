{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chem-chain-map/schemas/nodes.schema.json",
  "title": "nodes.json",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": { "column_note": { "type": "string" } }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["col", "label"],
        "properties": {
          "col": { "type": "integer" },
          "label": { "type": "string", "minLength": 1 },
          "side": { "enum": ["up", "core", "down"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "node_class", "node_role", "segment", "cas", "missing_flags", "evidence"],
        "anyOf": [{ "required": ["column"] }, { "required": ["layer"] }],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "node_class": { "enum": ["commodity", "material", "application", "route", "utility"] },
          "node_role": {
            "enum": ["raw", "byproduct", "intermediate", "monomer", "auxiliary", "target",
                     "compound", "article", "system", "derivative", "same_family",
                     "substitute", "end_market"]
          },
          "segment": { "type": "string", "minLength": 1 },
          "column": { "type": "integer" },
          "layer": { "type": "integer", "description": "兼容旧字段；新数据用 column" },
          "cas": {
            "type": ["object", "null"],
            "required": ["value", "status"],
            "properties": {
              "value": { "type": ["string", "null"] },
              "status": { "enum": ["verified", "unverified", "reference", "不适用", "draft"] },
              "note": { "type": ["string", "null"] },
              "scope": { "type": ["string", "null"] }
            }
          },
          "hs_code": { "type": ["object", "string", "null"] },
          "specs": { "type": "array", "items": { "type": "string" } },
          "unit": { "type": ["string", "null"] },
          "sort_key": { "type": ["string", "null"] },
          "identification_confidence": { "enum": ["high", "medium", "low"] },
          "missing_flags": {
            "type": "array",
            "items": {
              "enum": ["price_missing", "price_partial", "capacity_missing", "quant_missing",
                       "process_missing", "evidence_missing", "cas_disputed", "identity_uncertain",
                       "unit_mixed"]
            }
          },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "price_mapped_ok": { "type": "boolean" },
          "price_mapped_note": { "type": ["string", "null"] },
          "capacity_mapped_ok": { "type": "boolean" },
          "capacity_mapped_note": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  },
  "description": "node_class：commodity=化学品（须有可核验 CAS）；material=配方材料/制品（CAS 标『不适用』）；application=终端应用（无 CAS 无价格无产能）；route=工艺路线节点；utility=公用工程。node_role 决定同列内上下分区顺序。column 是图谱列号，从左到右递增；缺列号不连续是正常的。"
}
